root = true

# Defaults for every file
[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space

[examples/exception-eol.md]
charset = utf-8-bom
trim_trailing_whitespace = false
insert_final_newline = false

[examples/excepcion-eol.md]
charset = utf-8-bom
trim_trailing_whitespace = false
insert_final_newline = false
