{
  "name": "multilang",
  "description": "Tools for multilanguage and Markdown multilang",
  "version": "1.2.1",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "license": "MIT",
  "repository": "https://github.com/codenautas/multilang",
  "contributors": [
    {
      "name": "Emilio Platzer",
      "email": "emilioplatzer@gmail.com"
    },
    {
      "name": "Diego Florio",
      "email": "diegoefe@gmail.com"
    }
  ],
  "bin": {
    "multilang": "./bin/multilang-run.js"
  },
  "main": "./bin/multilang.js",
  "overrides": {
    "diff": ">=8.0.2",
    "serialize-javascript": ">=7.0.0",
    "uuid": ">=14.0.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "js-yaml": "^4.1.1",
    "strip-bom-string": "^1.0.0",
    "best-globals": "^2.1.4"
  },
  "devDependencies": {
    "expect.js": "^0.3.1",
    "nyc": "^18.0.0",
    "mocha": "^11.7.5",
    "expect-called": "^0.4.0"
  },
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "test": "mocha --reporter spec --bail --check-leaks test/",
    "test-ci": "nyc --reporter=lcov mocha --reporter spec --check-leaks test/",
    "test-cov": "nyc mocha --reporter dot --check-leaks test/",
    "qac": "qa-control . -v",
    "all": "npm test && npm run test-cov && npm run qac",
    "start": "node example/server.js"
  },
  "files": [
    "bin",
    "langs"
  ],
  "qa-control": {
    "package-version": "0.3.0",
    "coverage": 99,
    "run-in": "server",
    "stability": "extending",
    "type": "cmd-tool"
  }
}
